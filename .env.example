# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG_MODE=false

# Model Configuration
MODEL_CACHE_DIR=./models
DEFAULT_MODEL_SIZE=1.7B
USE_GPU=auto
DEVICE_MAP=cuda:0

# Generation Defaults
DEFAULT_TEMPERATURE=0.9
DEFAULT_TOP_K=50
DEFAULT_TOP_P=1.0
MAX_NEW_TOKENS=2048

# Audio Settings
OUTPUT_SAMPLE_RATE=24000
DEFAULT_OUTPUT_FORMAT=wav

# Download Settings
AUTO_DOWNLOAD_MODELS=true
HUGGINGFACE_MIRROR=
